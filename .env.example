# Copy selected settings to an ignored .env file; never commit real credentials.
# Process environment values take precedence over both dotenv files. If both
# files define a value, backend/.env takes precedence over the repository .env.

# Application settings
APP_NAME="MyAIProject"
APP_ENV=development
APP_PORT=8000
DEBUG=false

# Database (set either POSTGRES_* values or DATABASE_URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caselibrary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_local_password
# DATABASE_URL=******localhost:5432/caselibrary

# Hosted AI settings; leave credentials unset when using deterministic/local work.
# OPENAI_API_KEY=replace-with-your-key
# OPENAI_ORG_ID=org-example # retained for compatibility; not sent to embeddings
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TEXT_GENERATION_PROVIDER=openai

# Optional local Ollama provider
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:4b
LOCAL_EMBEDDING_DEVICE=cpu

# Optional settings consumed by active backend modules
CASELIBRARY_SEMANTIC_ENABLED=true
CASELIBRARY_HYBRID_ENABLED=true
CASELIBRARY_LOCAL_SEMANTIC_ENABLED=false
CASELIBRARY_EMBED_ON_INGEST_ENABLED=false
CASELIBRARY_CITATION_PIPELINE=v2
CASELIBRARY_FOCUS_MASTER_300=false
# CASELIBRARY_RECENT_5000_IVFFLAT_PROBES=12
# CASELIBRARY_SECURITY_HEADERS=false
# CASELIBRARY_HSTS_MAX_AGE=31536000
# CASELIBRARY_AUDIT_LOG=logs/requests.jsonl
# CASELIBRARY_AUDIT_LOG_RAW_ADDRESS=false
# DEIDENTIFY_SPACY_MODEL=en_core_web_sm
# STEPS_ENV=

# Optional source adapter settings
# CANLII_API_KEY=replace-with-your-key
CANLII_API_BASE_URL=https://api.canlii.org
CANLII_API_USER_AGENT=AI-CaseLibrary/1.0

# Optional upload/parser limits (defaults documented in docs/CONFIGURATION_REFERENCE.md)
# LITINTEL_MAX_UPLOAD_BYTES=10485760
# LITINTEL_MAX_DOCX_UNCOMPRESSED_BYTES=104857600
# LITINTEL_MAX_DOCX_ARCHIVE_ENTRIES=2000
# LITINTEL_MAX_PDF_PAGES=500
# LITINTEL_MAX_EXTRACTED_TEXT_CHARS=5000000
# LITINTEL_MAX_PASTED_TEXT_CHARS=1000000

# Optional access settings. The access gate remains disabled unless a password
# is deliberately configured; these examples are comments, not active values.
# CASELIBRARY_ACCESS_PASSWORD=replace-with-a-strong-password
# CASELIBRARY_SESSION_SECRET=replace-with-a-separate-random-secret
# CASELIBRARY_SESSION_SECONDS=86400
# SECRET_KEY=replace-with-a-random-secret
