# ============================================================
# .env.example — AI-Friendly Dev Environment
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- App Settings ---
APP_NAME="MyAIProject"
APP_ENV="development"            # development | staging | production
APP_PORT=8000
DEBUG=true
SECRET_KEY="change-me-to-a-long-random-string"

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=myai_db
POSTGRES_USER=myai_user
POSTGRES_PASSWORD=your_db_password_here

# Full connection string (auto-built from above or override directly)
DATABASE_URL="postgresql://myai_user:your_db_password_here@localhost:5432/myai_db"

# --- pgvector Settings ---
VECTOR_DIMENSION=1536            # Must match your embedding model output size
VECTOR_INDEX_TYPE=ivfflat        # ivfflat | hnsw

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_ORG_ID=org-your-org-id-here    # Optional
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (optional) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Copilot / GitHub ---
GITHUB_TOKEN=ghp_your-github-token-here   # Required for GitHub Copilot API access
GITHUB_USERNAME=your-github-username

# --- Logging ---
LOG_LEVEL=DEBUG                  # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/app.log

# --- CORS (comma-separated origins) ---
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# --- JWT Auth ---
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
